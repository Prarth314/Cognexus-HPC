{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "resolveJsonModule": true
  },
  "include": [
    "index.tsx",
    "App.tsx",
    "web/**/*.tsx",
    "web/**/*.ts",
    "shared/**/*.ts",
    "vite.config.ts"
  ]
}
