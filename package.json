{
  "name": "cognexus-hpc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "build": "npm run check && vite build && tsc -p tsconfig.server.json && node scripts/copy-runtime.mjs",
    "start": "node dist-server/server/index.js",
    "db:migrate": "tsx server/migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@electric-sql/pglite": "^0.3.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^10.1.8",
    "csv-parse": "^7.0.3",
    "fastify": "^5.0.0",
    "lucide-react": "^0.563.0",
    "pg": "^8.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/pg": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
