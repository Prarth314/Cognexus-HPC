# Local development: persistent embedded PostgreSQL in .data/db.
NODE_ENV=development
PORT=3001
PUBLIC_ORIGIN=http://localhost:3000
DATA_DIR=.data
# Production requires PostgreSQL, HTTPS, and an invitation-only registration code.
# DATABASE_URL=postgresql://cognexus:replace-me@localhost:5432/cognexus
# SIGNUP_CODE=replace-with-a-random-secret-at-least-24-characters
# GEMINI_API_KEY=server-only-optional
# GEMINI_MODEL=set-a-model-available-to-your-account
# Optional S3-compatible private storage (otherwise private local disk).
# S3_BUCKET=cognexus-private
# S3_REGION=us-east-1
# S3_ENDPOINT=https://your-object-store
# S3_FORCE_PATH_STYLE=false
# AWS_ACCESS_KEY_ID=server-only
# AWS_SECRET_ACCESS_KEY=server-only
